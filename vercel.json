{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "framework": null,
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "vendor/**"
    }
  },
  "routes": [
    {
      "src": "/super-admin(/.*)?",
      "has": [{ "type": "host", "value": "^admin\\.nexuscmshub\\.com$" }],
      "status": 308,
      "headers": { "Location": "https://nexuscmshub.com/super-admin$1" }
    },
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "^admin\\.nexuscmshub\\.com$" }],
      "status": 308,
      "headers": { "Location": "https://nexuscmshub.com/super-admin" }
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index"
    },
    {
      "src": "/feedback-files/(.*)",
      "dest": "/api/index"
    },
    {
      "src": "/admin",
      "dest": "/index.html"
    },
    {
      "src": "/admin/(.*)",
      "dest": "/index.html"
    },
    {
      "src": "/super-admin",
      "dest": "/index.html"
    },
    {
      "src": "/super-admin/(.*)",
      "dest": "/index.html"
    },
    {
      "src": "/",
      "dest": "/api/index"
    },
    {
      "src": "/assets/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index"
    }
  ]
}
